{
  "name": "@woz-scratch/tplink-ipc-sdk",
  "version": "0.0.1",
  "description": "TP-Link IPC Camera SDK - Authentication and Lens Mask Control",
  "type": "module",
  "main": "src/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth": "vitest run tests/auth.test.js",
    "test:api": "vitest run tests/api.test.js",
    "mask:on": "node src/cli.js on",
    "mask:off": "node src/cli.js off",
    "mask:status": "node src/cli.js status"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "dotenv": "^16.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
